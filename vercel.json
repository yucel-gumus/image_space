{
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/remote-photos/:path*",
      "destination": "https://storage.googleapis.com/experiments-uploads/g2demos/photo-applet/:path*"
    },
    {
      "source": "/((?!api/|remote-photos/).*)",
      "destination": "/index.html"
    }
  ]
} 